	fimc-is_sensor_12a10@208 {
		compatible = "samsung,sensor-module-12a10";
		pinctrl-names = "pin0\0pin1\0pin2\0release";
		pinctrl-0;
		pinctrl-1 = <0xfc>;
		pinctrl-2 = <0x100>;
		pinctrl-3;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		gpio_mclk = <0x88 0x00 0x01>;
		gpio_reset = <0x48 0x00 0x01>;
		gpio_avdd_en = <0xed 0x06 0x01>;
		gpio_dvdd_en = <0xed 0x04 0x01>;
		gpio_iovdd_en = <0xed 0x05 0x01>;
		status = "okay";
		linux,phandle = <0x1c1>;
		phandle = <0x1c1>;

		af {
			product_name = <0x14>;
			i2c_ch = <0x00>;
		};

		flash {
			product_name = <0x0e>;
		};

		ois {
			product_name = <0x64>;
		};

		eeprom {
			product_name = <0x03>;
		};

		internal_vc {
			vc_list = <0x01 0x04 0x00 0x02 0x02 0x00>;
		};
	};

	fimc-is_sensor_5e9@41 {
		compatible = "samsung,sensor-module-5e9";
		pinctrl-names = "pin0\0pin1\0pin2\0release";
		pinctrl-0;
		pinctrl-1 = <0xff>;
		pinctrl-2 = <0x103>;
		pinctrl-3;
		position = <0x02>;
		id = <0x03>;
		mclk_ch = <0x03>;
		sensor_i2c_ch = <0x03>;
