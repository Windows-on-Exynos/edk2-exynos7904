							cirrus,bin-file = "None";
							cirrus,full-name;
							cirrus,compr-caps = <0x0e 0x01 0x04 0x01 0x3e80>;
						};
					};
				};
			};

			controller-data {
				samsung,spi-feedback-delay = <0x01>;
				samsung,spi-chip-select-mode = <0x00>;
			};
		};
	};

