				cs47l35-gpio-defaults {
					linux,phandle = <0x1c0>;
					phandle = <0x1c0>;

					aif1 {
						groups = "aif1";
						function = "aif1";
						bias-bus-hold;
					};

					aif2 {
						groups = "aif2";
						function = "aif2";
						bias-bus-hold;
					};

					aif3 {
						groups = "aif3";
						function = "aif3";
						bias-bus-hold;
					};

					gpio6 {
						groups = "gpio6";
						function = "opclk";
						bias-pull-up;
						output-low;
					};

					gpio5 {
						groups = "gpio5";
						function = "io";
					};
				};
			};

